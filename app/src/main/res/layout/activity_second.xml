<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainSecond"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F7"
    tools:context=".SecondActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Título Superior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_detalle_contacto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginBottom="24dp" />

        <!-- Tarjeta Principal de Perfil -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- Foto de Perfil -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="2dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/imgDetalleFoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_contact_placeholder"
                        android:contentDescription="@string/desc_foto_contacto" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Nombre Completo -->
                <TextView
                    android:id="@+id/txtDetalleNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:textAlignment="center"
                    tools:text="Juan Pérez"
                    android:layout_marginBottom="4dp" />

                <!-- País y Código -->
                <TextView
                    android:id="@+id/txtDetallePais"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    tools:text="País: Honduras (+504)"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="16dp" />

                <!-- Teléfono de Contacto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_telefono_detalle"
                        android:textStyle="bold"
                        android:textColor="#374151"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txtDetalleTelefono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2563EB"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        tools:text="+504 9999-9999" />
                </LinearLayout>

                <!-- Nota / Descripción -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_nota_detalle"
                        android:textStyle="bold"
                        android:textColor="#374151"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txtDetalleNota"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#4B5563"
                        android:textSize="15sp"
                        tools:text="Sin nota adicional registrada." />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón de Llamar al Contacto -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLlamar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/btn_llamar"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            android:layout_marginBottom="12dp" />

        <!-- Botón de Regresar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresar"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/btn_regresar"
            android:textSize="16sp"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>
